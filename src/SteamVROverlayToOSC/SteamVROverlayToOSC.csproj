<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <MauiVersion>11.0.10</MauiVersion>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <OutputType>Exe</OutputType>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationTitle>SteamVR Overlay to OSC</ApplicationTitle>
    <ApplicationId>com.ajh657.steamvroverlaytoosc</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <WindowsPackageType>None</WindowsPackageType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="11.0.10" />
    <PackageReference Include="Microsoft.Maui.Controls.Build.Tasks" Version="11.0.10" />
    <PackageReference Include="Microsoft.Maui.Controls.Core" Version="11.0.10" />
    <PackageReference Include="Microsoft.Maui.Controls.Xaml" Version="11.0.10" />
    <PackageReference Include="Microsoft.Maui.Core" Version="11.0.10" />
    <PackageReference Include="Microsoft.Maui.Essentials" Version="11.0.10" />
    <PackageReference Include="Microsoft.Maui.Graphics" Version="11.0.10" />
    <PackageReference Include="Microsoft.Maui.Resizetizer" Version="11.0.10" />
  </ItemGroup>
</Project>
